<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disabled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/tvStatus"
    />
    <Button
            android:text="@string/btn_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStatus"
            android:id="@+id/btnAlternar"
    />
    <SeekBar
            android:layout_width="204dp"
            android:layout_height="34dp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.497" app:layout_constraintBottom_toTopOf="@+id/tvStatus"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/sbVolume"
            app:layout_constraintVertical_bias="0.636"
    />
    <TextView
            tools:text="Volume: 0 mB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/sbVolume" app:layout_constraintStart_toStartOf="@+id/sbVolume"
            android:id="@+id/tvVolume"
            app:layout_constraintBottom_toTopOf="@+id/sbVolume" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.93"
    />


</androidx.constraintlayout.widget.ConstraintLayout>